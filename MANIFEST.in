include README.md
include LICENSE
include CHANGELOG.md

# Include all Python files and the typing marker
recursive-include src/vcs *.py
include src/vcs/py.typed

# Exclude everything else to keep package small
prune docs
prune .github
prune tests
prune build
prune dist
prune *.egg-info

# Exclude development and build artifacts
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__
global-exclude .git*
global-exclude .DS_Store
global-exclude *.so
global-exclude .coverage
global-exclude .pytest_cache
global-exclude tag_version.py
global-exclude CONTRIBUTING.md
global-exclude DEPLOYMENT.md